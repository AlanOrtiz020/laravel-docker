# Copia este archivo a .env (junto a docker-compose.yml) y completa los valores.
# NO subas el .env a git. Y en el servidor NO crees un src/.env: la configuración es esta.

# Usuario del servidor dueño de src/ (en EC2 ubuntu/ec2-user es 1000; verifícalo con: id -u ; id -g)
HOST_UID=1000
HOST_GID=1000

APP_NAME="Wilvil"
APP_ENV=production
# Genera la clave con:
#   docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.cl

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- MySQL 8.4 (contenedor "mysql" de docker-compose) ---
# DB_HOST debe ser "mysql" (el nombre del servicio), no 127.0.0.1.
# La base y el usuario se crean solos la primera vez que arranca el contenedor.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wilvil
DB_USERNAME=wilvil_app
DB_PASSWORD=cambia-esto
# Contraseña del usuario root de MySQL (solo para administración, la app no la usa)
DB_ROOT_PASSWORD=cambia-esto-tambien

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Ponlo en false mientras no tengas HTTPS (si no, el login no funciona)
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Correo (ej. Amazon SES por SMTP) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="adquisiciones@wilvil.cl"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
