# MySQL 8.4 liviano para EC2 t3.micro (1 GB de RAM compartida con PHP).
# Consumo esperado: ~200-250 MB. Con más RAM, subir innodb_buffer_pool_size.
[mysqld]
innodb_buffer_pool_size = 128M
innodb_log_buffer_size = 8M
innodb_redo_log_capacity = 64M
performance_schema = OFF
max_connections = 40
table_open_cache = 400
table_definition_cache = 400
thread_cache_size = 8
tmp_table_size = 16M
max_heap_table_size = 16M
key_buffer_size = 8M
sort_buffer_size = 1M
join_buffer_size = 1M
skip-name-resolve
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
